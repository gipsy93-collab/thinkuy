# Copia este archivo como `.env` y rellena lo que tengas.
# `.env` NO se sube al repositorio (está en .dockerignore y debe estar en .gitignore).
#
# Todas son OPCIONALES: sin ellas el servidor arranca y las fuentes que las requieren
# se declaran no disponibles en lugar de reventar.

# --- Claves de fuentes (recomendadas) ---
# OpenAlex sin clave da 100 créditos/día; con clave, mucho más.
THINKUY_OPENALEX_API_KEY=
# CORE (api.core.ac.uk) para literatura gris y repositorios.
CORE_API_KEY=
# Redalyc (si se usa su API con token).
REDALYC_TOKEN=

# --- Configuración del servicio (obligatoria en producción) ---
# Lista separada por comas. NUNCA `*` en un servicio público.
THINKUY_CORS_ORIGINS=http://localhost:8000
# La búsqueda NO escribe en el catálogo (comportamiento de servidor).
THINKUY_INDEX_LIVE_RESULTS=0
# Dónde vive la base de datos (el volumen del contenedor).
THINKUY_DATA_DIR=/data
# Campo activo por defecto: neutro. Un perfil de disciplina es decisión explícita.
THINKUY_FIELD=general

# --- Common Crawl (SCIVIS: Centralidad Armónica, PageRank, in-links) ---
# Los datasets pesados del Web Graph NO viven en el repositorio. Sin estas rutas (o sin los
# archivos en su sitio) la auditoría editorial declara «Dataset no instalado» y muestra 0.
# En local, por defecto, se leen de D:\ (el mismo sitio donde los escriben las herramientas
# tools/index_cc_ranks.py y tools/build_cc_inlinks.py). En un contenedor, apunta al volumen.
# THINKUY_CC_DATA_DIR=/data/commoncrawl
# Rutas individuales (sobrescriben THINKUY_CC_DATA_DIR):
# THINKUY_CC_RANKS_DB=/data/commoncrawl/cc_domain_ranks.db
# THINKUY_CC_INLINKS_DB=/data/commoncrawl/cc_inlinks.db
# THINKUY_CC_HISTORY_DIR=/data/commoncrawl/cc_ranks_history
