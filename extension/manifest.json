{
  "manifest_version": 3,
  "name": "Thinkuy",
  "version": "0.3.0",
  "description": "Thinkuy: radar de comunicación científica. Publicaciones en conversación con tu campo.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Thinkuy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
        "id": "thinkuy@tinkuylab.org",
      "strict_min_version": "115.0"
    }
  }
}